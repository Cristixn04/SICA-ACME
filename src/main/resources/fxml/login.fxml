<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de Login (Inicio de Sesion).
     El layout declarativo vive aqui; el controlador VistaLogin inyecta el
     fondo blueprint, conecta el selector de rol y valida/autentica en
     un hilo de fondo (no bloquea el hilo FX). -->
<StackPane fx:id="raiz" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1">

    <fx:define>
        <ToggleGroup fx:id="grupoRol"/>
    </fx:define>

    <VBox fx:id="tarjeta" styleClass="tarjeta" alignment="CENTER" spacing="16"
          maxWidth="430">
        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <StackPane fx:id="logoSica"/>

        <Label styleClass="acme-titulo-medio" text="Inicio de Sesión"/>

        <!-- Usuario -->
        <HBox fx:id="cajaUsuario" styleClass="campo-caja" alignment="CENTER_LEFT" maxWidth="360">
            <Label styleClass="campo-icono" text="👤"/>
            <TextField fx:id="campoUsuario" styleClass="campo-plano"
                       promptText="DNI o Legajo" HBox.hgrow="ALWAYS"
                       onAction="#onIngresar"/>
        </HBox>

        <!-- Contraseña -->
        <HBox fx:id="cajaPass" styleClass="campo-caja" alignment="CENTER_LEFT" maxWidth="360">
            <Label styleClass="campo-icono" text="🔒"/>
            <PasswordField fx:id="campoPass" styleClass="campo-plano"
                           promptText="Contraseña" HBox.hgrow="ALWAYS"
                           onAction="#onIngresar"/>
        </HBox>

        <!-- Selector de rol -->
        <VBox alignment="CENTER" spacing="8" maxWidth="380">
            <Label styleClass="texto-muted" text="Seleccione su Rol para Iniciar Sesión"/>
            <HBox alignment="CENTER" spacing="10">
                <ToggleButton fx:id="btnFuncionario" styleClass="btn-rol" toggleGroup="$grupoRol"
                              minWidth="112" prefWidth="112" minHeight="58" wrapText="true"
                              textAlignment="CENTER" text="🏢  Funcionario&#10;de Empresa"/>
                <ToggleButton fx:id="btnGuarda" styleClass="btn-rol" toggleGroup="$grupoRol"
                              selected="true" minWidth="112" prefWidth="112" minHeight="58"
                              wrapText="true" textAlignment="CENTER" text="🛡  Guarda de&#10;Seguridad"/>
                <ToggleButton fx:id="btnAdmin" styleClass="btn-rol" toggleGroup="$grupoRol"
                              minWidth="112" prefWidth="112" minHeight="58" wrapText="true"
                              textAlignment="CENTER" text="🔑  Administrador"/>
            </HBox>
        </VBox>

        <Label fx:id="error" styleClass="texto-error" visible="false" wrapText="true"/>

        <Button fx:id="btnIngresar" styleClass="btn-acme" text="Ingresar"
                maxWidth="240" prefWidth="240" onAction="#onIngresar"/>

        <HBox alignment="CENTER" spacing="18">
            <Label fx:id="linkOlvido" styleClass="link" text="¿Olvidó su contraseña?"/>
            <Label fx:id="linkSolicitar" styleClass="link" text="Solicitar Acceso (ZONA ACME)"/>
        </HBox>
    </VBox>
</StackPane>