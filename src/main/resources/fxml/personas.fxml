<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="14" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <!-- Barra Superior -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label styleClass="acme-titulo" text="Gestión de Personal y Personas"/>
            <Label styleClass="acme-subtitulo" text="Control central de empleados, contratistas y visitantes registrados"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnAgregar" styleClass="btn-verde" text="＋ Registrar Persona" onAction="#onAgregar"/>
            <Button fx:id="btnBloquear" styleClass="btn-rojo" text="🚫 Bloquear Acceso" onAction="#onBloquear"/>
            <Button fx:id="btnActivar" styleClass="btn-gris" text="✓ Activar Acceso" onAction="#onActivar"/>
        </HBox>
    </HBox>

    <!-- Barra de Busqueda -->
    <HBox fx:id="barraBusqueda" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="buscador" styleClass="campo" promptText="Buscar por nombre, DNI o departamento..."
                   HBox.hgrow="ALWAYS" onAction="#onBuscar"/>
        <Button fx:id="btnBuscar" styleClass="btn-gris" text="Buscar" onAction="#onBuscar"/>
        <Button fx:id="btnLimpiar" styleClass="btn-gris" text="Mostrar todos" onAction="#onLimpiar"/>
    </HBox>

    <!-- Tabla de Personas -->
    <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="120"/>
            <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="240"/>
            <TableColumn fx:id="colPuesto" text="Puesto" prefWidth="170"/>
            <TableColumn fx:id="colDepto" text="Departamento" prefWidth="160"/>
            <TableColumn fx:id="colEmail" text="Email Corporativo" prefWidth="220"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>